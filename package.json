{
  "name": "native-location",
  "private": true,
  "packageManager": "pnpm@10.12.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@native-location/api",
    "dev:mobile": "pnpm --filter @native-location/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "precommit": "pnpm format && pnpm lint:fix && pnpm typecheck",
    "db:up": "node scripts/wsl-compose.mjs up -d",
    "db:down": "node scripts/wsl-compose.mjs down",
    "db:logs": "node scripts/wsl-compose.mjs logs -f postgres",
    "db:generate": "pnpm --filter @native-location/api prisma:generate",
    "db:migrate": "pnpm --filter @native-location/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @native-location/api prisma:migrate:deploy",
    "db:studio": "pnpm --filter @native-location/api prisma:studio",
    "apk:agent": "node scripts/apk-build-agent.mjs",
    "apk:build": "node scripts/build-android-apk.mjs",
    "clean": "node scripts/clean-node-modules.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.4.2",
    "turbo": "^2.5.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "metro": "0.83.3",
      "metro-babel-transformer": "0.83.3",
      "metro-cache": "0.83.3",
      "metro-cache-key": "0.83.3",
      "metro-config": "0.83.3",
      "metro-core": "0.83.3",
      "metro-file-map": "0.83.3",
      "metro-minify-terser": "0.83.3",
      "metro-resolver": "0.83.3",
      "metro-runtime": "0.83.3",
      "metro-source-map": "0.83.3",
      "metro-symbolicate": "0.83.3",
      "metro-transform-plugins": "0.83.3",
      "metro-transform-worker": "0.83.3",
      "react-native-reanimated": "~4.1.1",
      "react-native-worklets": "0.5.1"
    }
  }
}
