{
  "expo": {
    "name": "NativeLocation",
    "slug": "native-location",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "nativelocation",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nativelocation.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "用于实时上报你的位置，实现定位追踪。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "用于在后台持续上报位置（预留能力）。",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.nativelocation.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "允许 NativeLocation 在后台获取位置以便持续上报。",
          "locationWhenInUsePermission": "允许 NativeLocation 在使用期间获取位置。",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}
