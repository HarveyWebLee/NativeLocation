# 仅供 VPS：复制为仓库根目录 .env.production（已 gitignore）。
# 不要把本文件或开发机 .env 打进客户端包；手机生产配置走 EAS 环境变量。

NODE_ENV=production
POSTGRES_USER=nativelocation
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=nativelocation
# 容器内主机与端口由 docker-compose.prod.yml 注入（postgres:5432），不必写 DATABASE_URL

API_KEY=请改成足够长的随机串
CORS_ORIGIN=

# 手机 EAS 生产构建（在 Expo 控制台或 eas.json env 中配置，不要提交真实值）
# EXPO_PUBLIC_API_HTTP_URL=https://api.example.com:18201
# EXPO_PUBLIC_API_WS_URL=wss://api.example.com:18201/v1/location/stream
# EXPO_PUBLIC_API_KEY=与上面 API_KEY 相同
