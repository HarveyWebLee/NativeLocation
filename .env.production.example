# 仅供部署机：复制为仓库根目录 .env.production（已 gitignore）。
# 内测：Compose 起 postgres+api+web（不起 nginx）。见 docs/internal-release.md。
# 生产 HTTPS：再起 nginx + 证书。见 docs/deploy.md。
# 不要把本文件打进客户端仓库提交；EAS 独立包在 Expo 控制台配置同名 EXPO_PUBLIC_*。

NODE_ENV=production
POSTGRES_USER=nativelocation
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=nativelocation
# 宿主机映射仅 127.0.0.1（不对公网）。API 容器仍连 Docker 内网 postgres:5432。
POSTGRES_PORT=16875

API_KEY=请改成足够长的随机串
# 浏览器访问 Mobile Web 时必填，例如 http://<公网IP>:8881（可逗号分隔）
CORS_ORIGIN=

# Mobile Web 镜像构建参数，以及 EAS preview/production（控制台配置，勿提交真实值）
# 内测无域名示例：
# EXPO_PUBLIC_API_HTTP_URL=http://203.0.113.10:18156
# EXPO_PUBLIC_API_WS_URL=ws://203.0.113.10:18156/v1/location/stream
# EXPO_PUBLIC_API_KEY=与上面 API_KEY 相同
# 生产 HTTPS 示例：
# EXPO_PUBLIC_API_HTTP_URL=https://api.example.com:18201
# EXPO_PUBLIC_API_WS_URL=wss://api.example.com:18201/v1/location/stream

EXPO_PUBLIC_API_HTTP_URL=http://请改成公网IP:18156
EXPO_PUBLIC_API_WS_URL=ws://请改成公网IP:18156/v1/location/stream
EXPO_PUBLIC_API_KEY=请改成与 API_KEY 相同的值

# Mobile Web：宿主机与容器内均为 8881（与 Metro 同端口；勿与 pnpm dev:mobile 同时占用）
WEB_PORT=8881

# Compose 内 API 访问宿主机 APK agent（Windows/Mac Docker Desktop 默认即可）
# APK_BUILD_AGENT_URL=http://host.docker.internal:18210
