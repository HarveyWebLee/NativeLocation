# 本地开发唯一配置文件（复制本模板为仓库根目录 .env）。
# 不要再复制到 apps/api 或 apps/mobile。
# 生产：VPS 用 .env.production + Compose；独立包用 EAS 环境变量（见 docs/deploy.md）。

POSTGRES_USER=nativelocation
POSTGRES_PASSWORD=nativelocation
POSTGRES_DB=nativelocation
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=16875

# NestJS / Prisma（DATABASE_URL 由上述 POSTGRES_* 在进程内拼接，不要再手写）
PORT=18156

# Mobile（真机请改成电脑局域网 IP；Android 模拟器可用 10.0.2.2）
EXPO_PUBLIC_API_HOST=10.0.2.2
EXPO_PUBLIC_API_PORT=18156
