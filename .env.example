# 本地开发唯一配置文件（复制本模板为仓库根目录 .env）。
# 不要再复制到 apps/api 或 apps/mobile。
# 公网内测（Compose postgres+api+web）：用 .env.production，见 docs/internal-release.md。
# 生产 HTTPS：.env.production + nginx tls profile，见 docs/deploy.md。

POSTGRES_USER=nativelocation
POSTGRES_PASSWORD=nativelocation
POSTGRES_DB=nativelocation
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=16875

# NestJS / Prisma（DATABASE_URL 由上述 POSTGRES_* 在进程内拼接，不要再手写）
PORT=18156

# Mobile（Expo Go / Metro）
# - Android 模拟器可用 10.0.2.2
# - 同 Wi-Fi 真机：电脑局域网 IP
# - 对接公网内测 API：填公网 IP，并设置 EXPO_PUBLIC_API_KEY 与服务器 API_KEY 相同
EXPO_PUBLIC_API_HOST=10.0.2.2
EXPO_PUBLIC_API_PORT=18156

# 对接已设 API_KEY 的内测/生产 API 时取消注释
# EXPO_PUBLIC_API_KEY=
