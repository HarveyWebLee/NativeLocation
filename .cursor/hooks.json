{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/after-file-edit.mjs",
        "timeout": 60
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/before-mcp.mjs",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-quality-reminder.mjs",
        "timeout": 5,
        "loop_limit": 0
      }
    ]
  }
}
